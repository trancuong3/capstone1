# Local development / GitHub Actions:
APP_ENVIRONMENT="development"
DATABASE_URL="postgresql+asyncpg://<user>:<password>@<host>:5432/postgres"
DATABASE_POOLER_MODE="local"
DATABASE_SSL_REQUIRED="false"

# Render production (Supabase Dashboard -> Connect -> Transaction Pooler):
# APP_ENVIRONMENT="production"
# DATABASE_URL="postgresql+asyncpg://<pooler-user>:<url-encoded-password>@<pooler-host>:6543/postgres"
# DATABASE_POOLER_MODE="transaction"
# DATABASE_SSL_REQUIRED="true"
# DATABASE_SSL_ROOT_CERT="/etc/secrets/supabase-root.crt"

# Per-process cap on active SQLAlchemy database transactions.
# NullPool itself does not keep an application-side connection pool.
DATABASE_CONCURRENCY_LIMIT="8"
DATABASE_CONCURRENCY_WAIT_TIMEOUT="5"
DATABASE_CONNECT_TIMEOUT="10"
DATABASE_COMMAND_TIMEOUT="30"

# Supabase API configuration
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_KEY="your-publishable-key"

# Configure exactly one server-only Admin API key.
SUPABASE_SECRET_KEY="your-secret-key"
# Legacy service-role JWT key, supported as a fallback:
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Primary Supabase Storage buckets (catalog books, private parent books, avatars, TTS cache).
SUPABASE_STORAGE_BUCKET="book-pages"
SUPABASE_PRIVATE_BOOKS_BUCKET="viread-private-books"
SUPABASE_AVATAR_BUCKET="viread-avatars"
SUPABASE_TTS_CACHE_BUCKET="viread-tts-cache"
SUPABASE_CATALOG_TTS_BUCKET="viread-catalog-tts"
# Optional local filesystem storage root for isolated local staging / offline acceptance.
VIREAD_LOCAL_STORAGE_DIR=""

# Public backend URLs & runtime metadata (optional; used for private media proxy URLs and /health).
BACKEND_PUBLIC_URL=""
API_PUBLIC_URL=""
VIREAD_PROXYLESS_PRIVATE_URLS="false"
VIREAD_APP_VERSION=""
GIT_SHA=""

# Auth token & role verification cache TTLs + background worker toggles.
AUTH_TOKEN_CACHE_TTL_SECONDS="30"
VIREAD_ROLE_CACHE_TTL_SECONDS="30"
VIREAD_CRON_DISPATCH_TOKEN=""
BACKGROUND_WORKER_STARTUP_DELAY_SECONDS="5"
ADMIN_AI_WORKFLOW_WORKER_ENABLED="true"
ADMIN_AI_WORKFLOW_MAX_CONCURRENT_JOBS="2"
BOOK_QUALITY_SCAN_WORKER_ENABLED="true"
BOOK_QUALITY_SCAN_POLL_SECONDS="10"
PARENT_BOOK_WORKER_ENABLED="true"
PARENT_BOOK_WORKER_POLL_SECONDS="5"
VIREAD_OCR_OUTBOX_WORKER_ENABLED="true"

# Shared SMTP configuration for reading reminder emails and parent support feedback
# (backend/server only; never commit real credentials or app passwords).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="<authorized-smtp-account>"
SMTP_APP_PASSWORD=""
SMTP_FROM_EMAIL="<authorized-sender-address>"
SMTP_SEND_TIMEOUT_SECONDS="15"
SUPPORT_EMAIL="vireadforyou@gmail.com"
READING_REMINDER_POLL_SECONDS="30"
READING_REMINDER_MAX_ATTEMPTS="5"
READING_REMINDER_APP_URL="https://viread-frontend.vercel.app/reading-management"
PARENT_EMAIL_APP_URL="https://viread-frontend.vercel.app"
# Unified parent email automation (Resend HTTPS API recommended on Render/Vercel, or SMTP)
EMAIL_PROVIDER="auto"
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS=""
EMAIL_FROM_NAME="ViRead"
PARENT_EMAIL_CRON_SECRET=""
PARENT_EMAIL_WORKER_ENABLED="true"
PARENT_EMAIL_DIGEST_POLL_SECONDS="900"
# Optional local directory sink for parent/presence email testing (leave empty in production).
READING_PRESENCE_MAIL_SINK_DIR=""
PARENT_EMAIL_MAIL_SINK_DIR=""

# Local-First Voice Worker (loopback or HTTPS tunnel to Windows/worker host; default for STT & TTS).
VIREAD_LOCAL_VOICE_WORKER_URL="http://127.0.0.1:8010"
# Shared secret header X-ViRead-Voice-Token when Voice Worker is exposed over HTTPS tunnel.
VIREAD_VOICE_WORKER_TOKEN=""
# Legacy alias for VIREAD_VOICE_WORKER_TOKEN (optional fallback).
VIREAD_LOCAL_VOICE_WORKER_TOKEN=""
VIREAD_LOCAL_VOICE_WORKER_AUTOSTART="true"
VIREAD_DISABLE_VOICE_AUTOSTART="false"
VIREAD_VOICE_RUNTIME_DIR=""
VIREAD_VOICE_TTS_PRECISION="fp32"
VIREAD_STT_MODE="local_first"

# Precomputed & catalog TTS audio cache settings.
VIREAD_TTS_CACHE_ENABLED="true"
VIREAD_TTS_CACHE_MAX_BYTES="536870912"
VIREAD_TTS_CACHE_DAILY_EGRESS_LIMIT_BYTES="1073741824"
VIREAD_CATALOG_TTS_PUBLIC_ENABLED="true"
VIREAD_CATALOG_TTS_DEFAULT_VOICE_ID=""

# Remote OCR Worker separation (use "remote_worker" on constrained web hosts like Render Free 512 MiB).
VIREAD_OCR_MODE="local_inprocess"
VIREAD_WEB_DISABLE_HEAVY_WORKERS="false"
VIREAD_OCR_CPU_THREADS="2"
VIREAD_OCR_WORKER_TOKEN=""
VIREAD_OCR_WORKER_HEARTBEAT_TTL_SECONDS="60"
VIREAD_REMOTE_OCR_SYNC_TIMEOUT_SECONDS="45"
VIREAD_ACTIVE_MODEL_POLL_SECONDS="60"
VIREAD_HEALTH_OCR_TIMEOUT_SECONDS="5"
LOCAL_OCR_SCAN_TIMEOUT_SECONDS="120"
PRIVATE_BOOK_ALLOW_CLOUD_AI="false"

# Local Tesseract OCR 5.x binary & Vietnamese language data (used when OCR runs locally).
TESSERACT_CMD=""
TESSDATA_PREFIX=""
TESSERACT_LANG="vie"

# Page matching & PDF/DOCX document rasterization tuning.
VIREAD_MATCH_PAGE_CACHE_SIZE="256"
VIREAD_MAX_MATCH_PAGE_CANDIDATES="64"
VIREAD_RASTERIZER_FORMAT="JPEG"
VIREAD_RASTERIZER_JPEG_QUALITY="90"
VIREAD_DOCX_FONT_PATH=""

# Smart Book Studio V2 (OCR layout filter, Style Bible, cover/illustration generation).
SMART_OCR_FILTER_MODE="active"
GEMINI_STYLE_BIBLE_MODEL="gemini-2.5-flash"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_IMAGE_MODEL="@cf/black-forest-labs/flux-1-schnell"
LOCAL_IMAGE_GEN_URL=""
LOCAL_IMAGE_GEN_MODEL=""
LOCAL_IMAGE_GEN_ALLOW_LAN="false"

# Controlled Google Cloud Speech-to-Text / Text-to-Speech backup (server-only).
# Leave empty to keep Google backup disabled. Never expose these keys in frontend/APK.
GOOGLE_CLOUD_STT_API_KEY=""
GOOGLE_CLOUD_TTS_API_KEY=""
GOOGLE_CLOUD_API_KEY=""
GOOGLE_CLOUD_ACCESS_TOKEN=""

# Legacy ElevenLabs TTS/STT (kept only for isolated provider tests; not called by default).
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="JBFqnCBsd6RMkjVDRZzb"

# Cloud multimodal OCR correction. Keys are server-only secrets; leave empty to
# skip an unavailable cloud provider. Set false to use only local Ollama.
OCR_CLOUD_CORRECTION_ENABLED="true"
GEMINI_API_KEY=""
GROQ_API_KEY=""
GEMINI_OCR_PRIMARY_MODEL="gemini-3.5-flash-lite"
GEMINI_OCR_FALLBACK_MODEL="gemini-3.1-flash-lite"
GROQ_OCR_MODEL="qwen/qwen3.8-27b"
OCR_CLOUD_TIMEOUT_SECONDS="60"
OCR_CORRECTION_TOTAL_TIMEOUT_SECONDS="7200"

# Loopback-only local OCR refinement fallback (Ollama).
# Hardware benchmark winner (16 GB RAM / 4 GB VRAM): keep 4B model (2B failed JSON contract),
# set OLLAMA_NUM_PARALLEL=1, num_ctx=4096, and run Ollama at BelowNormal priority when sharing
# a single Windows host with interactive Voice Worker.
LOCAL_OCR_BASE_URL="http://127.0.0.1:11434"
LOCAL_OCR_MODEL="qwen3-vl:4b-instruct-q4_K_M"
LOCAL_OCR_MAX_CHUNK_BYTES="3072"
LOCAL_OCR_MAX_CHUNK_WORDS="48"
LOCAL_OCR_MAX_CHUNKS="128"
LOCAL_OCR_CONTEXT_BYTES="160"
LOCAL_OCR_MAX_DOCUMENT_BYTES="196608"
LOCAL_OCR_TIMEOUT_SECONDS="180"
LOCAL_OCR_TOTAL_TIMEOUT_SECONDS="7200"
LOCAL_OCR_NUM_CTX="4096"
LOCAL_OCR_NUM_PREDICT="1024"
LOCAL_OCR_KEEP_ALIVE="2m"
LOCAL_OCR_NUM_THREAD="2"
VIREAD_POST_OCR_CONCURRENCY="1"

# Picture description ("Kể chuyện qua tranh") multimodal AI chain:
# Gemini primary -> Gemini fallback -> Extra Gemini/Gemma models -> Groq (if GROQ_API_KEY set) -> Local Ollama.
PICTURE_DESC_CLOUD_ENABLED="true"
PICTURE_DESC_GEMINI_MODEL="gemini-3.1-flash-lite"
PICTURE_DESC_GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"
PICTURE_DESC_GEMINI_EXTRA_MODELS="gemma-4-26b-a4b-it,gemini-flash-lite-latest"
PICTURE_DESC_GROQ_MODEL="qwen/qwen3.8-27b"
PICTURE_DESC_TIMEOUT_SECONDS="15"
PICTURE_DESC_TRANSIENT_RETRIES="1"
PICTURE_DESC_HEDGED_GEMINI="true"
PICTURE_DESC_OLLAMA_ENABLED="true"

# Flow 2 background training scheduler. Local GPU resources are probed before a
# job is claimed; non-ready jobs are routed to the configured Colab worker.
VIREAD_OCR_AUTO_TRAINING_WORKER_ENABLED="true"
VIREAD_OCR_WARMUP_ENABLED="false"
VIREAD_LOCAL_TRAINING_ENABLED="true"
VIREAD_LOCAL_TRAINING_WORKER_AUTOSTART="true"
VIETOCR_TRAINING_MIN_VRAM_MIB="6144"
VIETOCR_TRAINING_MIN_RAM_GB="8"
VIETOCR_TRAINING_MIN_DISK_GB="8"
VIETOCR_TRAINING_WORK_DIR=""
VIETOCR_TRAINING_STEPS="5000"
VIETOCR_TRAINING_BATCH_SIZE="8"
VIETOCR_TRAINING_FREEZE_EPOCHS="5"
VIETOCR_TRAINING_SEED="20261113"
# Generate a random >=32-character value and configure the same secret in
# backend runtime and Google Colab Secrets. Never commit the generated value.
VIREAD_TRAINING_WORKER_TOKEN=""

# No-cost default: queue ready jobs for a user-started Colab Free notebook.
# Set to "enterprise" only when explicitly opting into billable Google Cloud.
VIREAD_COLAB_EXECUTION_MODE="manual"
VIREAD_COLAB_DISPATCH_URL=""
VIREAD_COLAB_DISPATCH_SHARED_SECRET=""
VIREAD_COLAB_REPOSITORY_URL="https://github.com/trancuong3/capstone1"
VIREAD_COLAB_REPOSITORY_COMMIT=""

# Flow 2 Google Drive-First AI Training Storage (0 VND personal Drive OAuth 2.0).
# Scope is strictly limited to https://www.googleapis.com/auth/drive.file.
# Never commit real OAuth client secrets or encryption keys to Git.
VIREAD_FLOW2_STORAGE_PROVIDER="google_drive"
VIREAD_GDRIVE_OAUTH_CLIENT_ID=""
VIREAD_GDRIVE_OAUTH_CLIENT_SECRET=""
VIREAD_GDRIVE_OAUTH_REDIRECT_URI="http://localhost:3000/admin/viread-training"
# Optional comma-separated allowlist of additional OAuth redirect URIs.
VIREAD_GDRIVE_OAUTH_ALLOWED_REDIRECT_URIS=""
# Random >=32-character secret used with Fernet to encrypt Google Drive refresh tokens at rest.
VIREAD_GDRIVE_TOKEN_ENCRYPTION_KEY=""
# Dedicated server-only >=32-character HMAC secret for worker artifact-stream URLs (never reuse VIREAD_TRAINING_WORKER_TOKEN).
VIREAD_ARTIFACT_STREAM_SIGNING_SECRET=""
# Safety headroom reserved before blocking new Flow 2 uploads (default: 512 MiB).
VIREAD_GDRIVE_MIN_FREE_BYTES="536870912"
# Optional cap (bytes) for Flow 2 Drive usage; 0 disables the additional cap.
VIREAD_GDRIVE_MAX_TRAINING_BYTES="0"
# Optional Google Apps Script / Drive Desktop bridge & storage quota guardrails.
VIREAD_GDRIVE_APPS_SCRIPT_URL=""
VIREAD_GDRIVE_APPS_SCRIPT_SECRET=""
VIREAD_GDRIVE_REQUIRED_ACCOUNT_EMAIL=""
VIREAD_GDRIVE_DESKTOP_ROOT=""
VIREAD_FLOW2_INGESTION_PAUSED="false"
VIREAD_OCR_DATABASE_LIMIT_BYTES="0"
VIREAD_OCR_STORAGE_LIMIT_BYTES="0"

# Comma-separated, exact origins for the deployed Next.js frontend.
# Example: https://viread.example.com,https://viread-preview.vercel.app
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Automatic karaoke is opt-in. Keep disabled until benchmark and live review pass.
# Run the AI engine in its own environment, never in the OCR backend venv.
KARAOKE_PROCESSING_ENABLED="false"
KARAOKE_PROCESSING_WORKER_ENABLED="false"
KARAOKE_PROCESSING_PIPELINE_VERSION=""
KARAOKE_ALIGNMENT_PROVIDER="local_ctc"
KARAOKE_STEM_PROVIDER="demucs"
KARAOKE_LOCAL_PYTHON=""
KARAOKE_LOCAL_ENGINE_SCRIPT=""
KARAOKE_LOCAL_MODEL_PATH=""
KARAOKE_LOCAL_STEM_MODEL_PATH=""
KARAOKE_TEMP_DIR=""
KARAOKE_WORKER_CONCURRENCY="1"
KARAOKE_WORKER_LEASE_SECONDS="120"
KARAOKE_WORKER_HEARTBEAT_SECONDS="20"
KARAOKE_WORKER_POLL_SECONDS="2"
KARAOKE_JOB_MAX_SAFE_ATTEMPTS="2"
KARAOKE_MAX_OUTSTANDING_PER_ADMIN="2"
KARAOKE_MAX_OUTSTANDING_GLOBAL="10"
# Required positive caps when enabled. Minutes are not a monetary billing cap.
KARAOKE_MAX_RESERVED_AUDIO_MINUTES_PER_ADMIN_DAY="0"
KARAOKE_MAX_RESERVED_AUDIO_MINUTES_GLOBAL_DAY="0"
KARAOKE_QUEUE_WAIT_WARNING_SECONDS="120"
KARAOKE_PROVIDER_TIMEOUT_SECONDS="180"
# Optional Render Free -> Vercel HTTPS mail relay (server-only).
# Select explicitly only after the relay is deployed and configured.
EMAIL_RELAY_URL=
EMAIL_RELAY_SECRET=

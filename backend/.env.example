DATABASE_URL="postgresql+asyncpg://<user>:<password>@<host>:5432/postgres"
# 2. Đường dẫn API của Supabase
SUPABASE_URL="https://<project-ref>.supabase.co"

# 3. Khóa API
SUPABASE_KEY="your-publishable-key"

# Optional server-only key for reading Auth user email/phone. Never use in frontend.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ElevenLabs credentials are server-only. Never place this key in frontend env files.
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
# Optional: choose your ElevenLabs voice. Without it, the API's documented public
# default voice is used; set this in production to lock the expected voice.
# ELEVENLABS_VOICE_ID="your-elevenlabs-voice-id"

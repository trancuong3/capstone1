# Local development / GitHub Actions:
APP_ENVIRONMENT="development"
DATABASE_URL="postgresql+asyncpg://<user>:<password>@<host>:5432/postgres"
DATABASE_POOLER_MODE="local"
DATABASE_SSL_REQUIRED="false"

# Render production (Supabase Dashboard -> Connect -> Transaction Pooler):
# APP_ENVIRONMENT="production"
# DATABASE_URL="postgresql+asyncpg://<pooler-user>:<url-encoded-password>@<pooler-host>:6543/postgres"
# DATABASE_POOLER_MODE="transaction"
# DATABASE_SSL_REQUIRED="true"
# DATABASE_SSL_ROOT_CERT="/etc/secrets/supabase-root.crt"

# Per-process cap on active SQLAlchemy database transactions.
# NullPool itself does not keep an application-side connection pool.
DATABASE_CONCURRENCY_LIMIT="8"
DATABASE_CONCURRENCY_WAIT_TIMEOUT="5"
DATABASE_CONNECT_TIMEOUT="10"
DATABASE_COMMAND_TIMEOUT="30"

# Supabase API configuration
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_KEY="your-publishable-key"

# Configure exactly one server-only Admin API key.
SUPABASE_SECRET_KEY="your-secret-key"
# Legacy service-role JWT key, supported as a fallback:
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Dedicated private bucket for parent and child avatar images.
SUPABASE_AVATAR_BUCKET="viread-avatars"

# Reading reminder email worker (server-only; never add the app password to git).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="vireadforyou@gmail.com"
SMTP_APP_PASSWORD=""
SMTP_FROM_EMAIL="vireadforyou@gmail.com"
SMTP_SEND_TIMEOUT_SECONDS="15"
READING_REMINDER_POLL_SECONDS="30"
READING_REMINDER_MAX_ATTEMPTS="5"
READING_REMINDER_APP_URL="https://your-app.example/reading-management"

# ElevenLabs TTS/STT (server-only).
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
ELEVENLABS_VOICE_ID="JBFqnCBsd6RMkjVDRZzb"

# Cloud multimodal OCR correction. Keys are server-only secrets; leave empty to
# skip an unavailable cloud provider. Set false to use only local Ollama.
OCR_CLOUD_CORRECTION_ENABLED="true"
GEMINI_API_KEY=""
GROQ_API_KEY=""
GEMINI_OCR_PRIMARY_MODEL="gemini-3.5-flash-lite"
GEMINI_OCR_FALLBACK_MODEL="gemini-3.1-flash-lite"
GROQ_OCR_MODEL="qwen/qwen3.8-27b"
OCR_CLOUD_TIMEOUT_SECONDS="60"
OCR_CORRECTION_TOTAL_TIMEOUT_SECONDS="7200"

# Loopback-only local OCR fallback (Ollama).
LOCAL_OCR_BASE_URL="http://127.0.0.1:11434"
LOCAL_OCR_MODEL="qwen3-vl:4b-instruct-q4_K_M"
LOCAL_OCR_MAX_CHUNK_BYTES="3072"
LOCAL_OCR_MAX_CHUNK_WORDS="48"
LOCAL_OCR_MAX_CHUNKS="128"
LOCAL_OCR_CONTEXT_BYTES="160"
LOCAL_OCR_MAX_DOCUMENT_BYTES="196608"
LOCAL_OCR_TIMEOUT_SECONDS="180"
LOCAL_OCR_TOTAL_TIMEOUT_SECONDS="7200"
LOCAL_OCR_NUM_CTX="4096"
LOCAL_OCR_NUM_PREDICT="1024"

# Flow 2 background training scheduler. Local GPU resources are probed before a
# job is claimed; non-ready jobs are routed to the configured Colab worker.
VIREAD_OCR_AUTO_TRAINING_WORKER_ENABLED="true"
VIREAD_OCR_WARMUP_ENABLED="false"
VIREAD_LOCAL_TRAINING_ENABLED="true"
VIREAD_LOCAL_TRAINING_WORKER_AUTOSTART="true"
VIETOCR_TRAINING_MIN_VRAM_MIB="6144"
VIETOCR_TRAINING_MIN_RAM_GB="8"
VIETOCR_TRAINING_MIN_DISK_GB="8"
VIETOCR_TRAINING_WORK_DIR=""
VIETOCR_TRAINING_STEPS="5000"
VIETOCR_TRAINING_BATCH_SIZE="8"
VIETOCR_TRAINING_FREEZE_EPOCHS="5"
VIETOCR_TRAINING_SEED="20261113"
# Generate a random >=32-character value and configure the same secret in
# backend runtime and Google Colab Secrets. Never commit the generated value.
VIREAD_TRAINING_WORKER_TOKEN=""

# No-cost default: queue ready jobs for a user-started Colab Free notebook.
# Set to "enterprise" only when explicitly opting into billable Google Cloud.
VIREAD_COLAB_EXECUTION_MODE="manual"
VIREAD_COLAB_DISPATCH_URL=""
VIREAD_COLAB_DISPATCH_SHARED_SECRET=""
VIREAD_COLAB_REPOSITORY_URL="https://github.com/trancuong3/capstone1"
VIREAD_COLAB_REPOSITORY_COMMIT=""

# ViRead support-feedback SMTP configuration (backend/server only).
# The sender must be authorized by the SMTP account.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="<authorized-smtp-account>"
SMTP_APP_PASSWORD="<provider-app-password>"
SMTP_FROM_EMAIL="<authorized-sender-address>"
SMTP_SEND_TIMEOUT_SECONDS="10"
SUPPORT_EMAIL="vireadforyou@gmail.com"

# Comma-separated, exact origins for the deployed Next.js frontend.
# Example: https://viread.example.com,https://viread-preview.vercel.app
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

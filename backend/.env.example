# Local development / GitHub Actions:
APP_ENVIRONMENT="development"
DATABASE_URL="postgresql+asyncpg://<user>:<password>@<host>:5432/postgres"
DATABASE_POOLER_MODE="local"
DATABASE_SSL_REQUIRED="false"

# Render production (Supabase Dashboard -> Connect -> Transaction Pooler):
# APP_ENVIRONMENT="production"
# DATABASE_URL="postgresql+asyncpg://<pooler-user>:<url-encoded-password>@<pooler-host>:6543/postgres"
# DATABASE_POOLER_MODE="transaction"
# DATABASE_SSL_REQUIRED="true"
# DATABASE_SSL_ROOT_CERT="/etc/secrets/supabase-root.crt"

# Per-process cap on active SQLAlchemy database transactions.
# NullPool itself does not keep an application-side connection pool.
DATABASE_CONCURRENCY_LIMIT="8"
DATABASE_CONCURRENCY_WAIT_TIMEOUT="5"
DATABASE_CONNECT_TIMEOUT="10"
DATABASE_COMMAND_TIMEOUT="30"

# Supabase API configuration
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_KEY="your-publishable-key"

# Configure exactly one server-only Admin API key.
SUPABASE_SECRET_KEY="your-secret-key"
# Legacy service-role JWT key, supported as a fallback:
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Dedicated private bucket for parent and child avatar images.
SUPABASE_AVATAR_BUCKET="viread-avatars"

# Reading reminder email worker (server-only; never add the app password to git).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="vireadforyou@gmail.com"
SMTP_APP_PASSWORD=""
SMTP_FROM_EMAIL="vireadforyou@gmail.com"
SMTP_SEND_TIMEOUT_SECONDS="15"
READING_REMINDER_POLL_SECONDS="30"
READING_REMINDER_MAX_ATTEMPTS="5"
READING_REMINDER_APP_URL="https://your-app.example/reading-management"

# ElevenLabs TTS/STT (server-only).
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
ELEVENLABS_VOICE_ID="JBFqnCBsd6RMkjVDRZzb"

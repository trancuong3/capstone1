# For cloud reminders, local FastAPI and GitHub Actions must use this SAME Supabase PostgreSQL database.
# Use the project's cloud connection string (prefer the Supabase pooler when appropriate); never use localhost/SQLite here.
DATABASE_URL="postgresql+asyncpg://<user>:<password>@<host>:5432/postgres"
# 2. Đường dẫn API của Supabase
SUPABASE_URL="https://<project-ref>.supabase.co"

# 3. Khóa API
SUPABASE_KEY="your-publishable-key"

# Configure exactly one server-only Admin API key in backend/.env.
# Current Supabase secret API key (preferred); never expose it to the browser.
SUPABASE_SECRET_KEY="your-secret-key"
# Legacy service-role JWT key (supported as a fallback for existing deployments).
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ElevenLabs TTS (server-only). Never expose in frontend.
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
ELEVENLABS_VOICE_ID="JBFqnCBsd6RMkjVDRZzb"


# Email reminders (server-only; leave empty to keep email delivery disabled).
RESEND_API_KEY=""
READING_REMINDER_FROM_EMAIL=""
# Absolute URL of the ViRead frontend; keep this set in deployment configuration.
READING_REMINDER_APP_URL="http://localhost:3000"
# Catch up only recent occurrences after downtime (0-1440 minutes; default 120).
READING_REMINDER_CATCH_UP_MINUTES="120"

DATABASE_URL="postgresql+asyncpg://<user>:<password>@<host>:5432/postgres"

# Supabase session-pooler connection budget. These values apply PER Uvicorn
# worker; total possible connections = instances * workers * (size + overflow).
# Keep the total below the provider's configured client limit (observed: 15).
DATABASE_POOL_SIZE="3"
DATABASE_MAX_OVERFLOW="0"
DATABASE_POOL_TIMEOUT="10"
DATABASE_POOL_RECYCLE="900"
# 2. Đường dẫn API của Supabase
SUPABASE_URL="https://<project-ref>.supabase.co"

# 3. Khóa API
SUPABASE_KEY="your-publishable-key"

# Configure exactly one server-only Admin API key in backend/.env.
# Current Supabase secret API key (preferred); never expose it to the browser.
SUPABASE_SECRET_KEY="your-secret-key"
# Legacy service-role JWT key (supported as a fallback for existing deployments).
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ElevenLabs TTS/STT (server-only). Never expose in frontend.
# After changing this value, restart every backend worker. A non-empty
# ELEVENLABS_API_KEY process environment variable takes precedence over .env.
# Backend logs show a short SHA-256 fingerprint (never the API key) so operators
# can verify which configured value the process loaded.
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
ELEVENLABS_VOICE_ID="JBFqnCBsd6RMkjVDRZzb"

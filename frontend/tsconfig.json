{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-gate/types/**/*.ts",
    ".next-gate/dev/types/**/*.ts",
    ".next-browser-verify/types/**/*.ts",
    ".next-browser-verify/dev/types/**/*.ts",
    ".next-e2e-tts/types/**/*.ts",
    ".next-e2e-tts/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next-*",
    ".next-*/**",
    "frontend/**",
    "coverage",
    "playwright-report",
    "test-results"
  ]
}

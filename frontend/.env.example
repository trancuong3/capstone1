# Copy this file to .env.local and fill in your own project values.
# Browser-safe configuration only. Never put a database password or
# Supabase secret/service-role key in the frontend.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"

# Production Vercel Hobby (non-commercial academic use only):
# - Select repository root directory: frontend
# - NEXT_PUBLIC_API_URL must be the actual HTTPS FastAPI origin; the connected
#   backend currently advertises https://capstone1-ssd8.onrender.com
# - All NEXT_PUBLIC_ values are embedded into the public JS bundle at build time.
# - Configure these values in the hosting provider's environment settings.
# - Never add service-role/secret keys or copy real values to this file.
# - Supabase Auth Site URL and exact redirect allowlist must match the deployed URL.

# Copy this file to .env.local and fill in your own project values.
# Browser-safe configuration only. Never put a database password or
# Supabase secret/service-role key in the frontend.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"

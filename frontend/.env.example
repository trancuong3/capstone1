# Copy this file to .env.local and fill in your own project values.
# Browser-safe configuration only. Never put a database password or
# Supabase secret/service-role key in the frontend.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"

# Optional calibrated Scribe v2 per-word confidence threshold (0..1).
# Leave unset until this threshold has been validated against real Vietnamese
# child speech. Without it, recognition is treated as UNCERTAIN, never guessed.
# NEXT_PUBLIC_READING_WORD_CONFIDENCE_THRESHOLD=""

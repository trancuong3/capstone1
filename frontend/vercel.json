{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["sin1"],
  "buildCommand": "npm run build:hosting && node scripts/smoke-parent-email-relay.mjs",
  "installCommand": "npm ci",
  "functions": {
    "api/parent-email-relay.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,.next/**,public/**,tests/**,test/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/parent-emails",
      "schedule": "0 2 * * *"
    }
  ]
}
